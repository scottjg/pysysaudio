# Documentation and license
include README.md
include LICENSE

# Examples
recursive-include examples *.py *.md

# Native sources for every supported platform. The sdist must carry all of
# them: setup.py only lists the current platform's sources in ext_modules,
# so setuptools will not pick up the other platform's files on its own.
include native/audio_recorder.h
include native/ring_buffer.h
include native/audio_recorder.mm
include native/audio_recorder_win.cpp
include native/bindings.cpp

# Build/packaging files
include pyproject.toml
include setup.py
include requirements.txt
include requirements-dev.txt

# Exclude build products and test artifacts
global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.so
global-exclude *.pyd
global-exclude *.dylib
global-exclude .DS_Store
global-exclude *.wav
prune .pytest_cache
